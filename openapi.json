{
  "openapi": "3.0.3",
  "info": {
    "title": "Translator",
    "version": "0.1.0",
    "description": "Private translation through a self-hosted LibreTranslate engine (AGPL-3.0)."
  },
  "paths": {
    "/api/translate": {
      "post": {
        "summary": "Translate text (saved to recent history unless save=false)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text",
                  "target"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "source": {
                    "type": "string",
                    "description": "Source code or auto (default)"
                  },
                  "target": {
                    "type": "string",
                    "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                  },
                  "save": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Translation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "translation": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string",
                      "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                    },
                    "target": {
                      "type": "string",
                      "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                    },
                    "detected": {
                      "type": "string",
                      "nullable": true
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid text or language"
          },
          "503": {
            "description": "Engine starting or offline"
          }
        }
      }
    },
    "/api/languages": {
      "get": {
        "summary": "Languages and engine readiness",
        "responses": {
          "200": {
            "description": "{engine: ready|offline, languages:[{code,name,local}]}"
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "summary": "Recent translations, newest first",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "History",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "history": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "translation": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "target": {
                            "type": "string"
                          },
                          "detected": {
                            "type": "string"
                          },
                          "updated": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save an already-translated pair; idempotent by id",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text",
                  "translation",
                  "source",
                  "target"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64
                  },
                  "text": {
                    "type": "string"
                  },
                  "translation": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                  },
                  "target": {
                    "type": "string",
                    "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "{id, history}"
          },
          "400": {
            "description": "Invalid"
          }
        }
      }
    },
    "/api/history/clear": {
      "post": {
        "summary": "Delete all recent translations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Empty history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "history": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "translation": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "target": {
                            "type": "string"
                          },
                          "detected": {
                            "type": "string"
                          },
                          "updated": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/prefs": {
      "get": {
        "summary": "Last chosen languages and enabled features",
        "responses": {
          "200": {
            "description": "Prefs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                    },
                    "target": {
                      "type": "string",
                      "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                    },
                    "features": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Remember the chosen languages",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                  },
                  "target": {
                    "type": "string",
                    "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prefs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                    },
                    "target": {
                      "type": "string",
                      "description": "LibreTranslate language code (th, en, ja, zh-Hans, ko, vi, es, fr, de, ru)"
                    },
                    "features": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/switches": {
      "get": {
        "summary": "Owner feature switches (wizard.app-switches/1)",
        "responses": {
          "200": {
            "description": "Switches"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "MCP streamable HTTP: translate, languages, history",
        "responses": {
          "200": {
            "description": "JSON-RPC"
          }
        }
      }
    }
  }
}
